/// One row per product. Made-up rows.
table Product

	/// Code of the product.
	column 'Product Code'
		dataType: string
		summarizeBy: none
		sourceColumn: ProductCode

	/// Made-up product attribute number 01.
	column 'Attribute 01'
		dataType: string
		summarizeBy: none
		sourceColumn: Attribute01

	/// Made-up product attribute number 02.
	column 'Attribute 02'
		dataType: string
		summarizeBy: none
		sourceColumn: Attribute02

	/// Made-up product attribute number 03.
	column 'Attribute 03'
		dataType: string
		summarizeBy: none
		sourceColumn: Attribute03

	/// Made-up product attribute number 04.
	column 'Attribute 04'
		dataType: string
		summarizeBy: none
		sourceColumn: Attribute04

	/// Made-up product attribute number 05.
	column 'Attribute 05'
		dataType: string
		summarizeBy: none
		sourceColumn: Attribute05

	/// Made-up product attribute number 06.
	column 'Attribute 06'
		dataType: string
		summarizeBy: none
		sourceColumn: Attribute06

	/// Made-up product attribute number 07.
	column 'Attribute 07'
		dataType: string
		summarizeBy: none
		sourceColumn: Attribute07

	/// Made-up product attribute number 08.
	column 'Attribute 08'
		dataType: string
		summarizeBy: none
		sourceColumn: Attribute08

