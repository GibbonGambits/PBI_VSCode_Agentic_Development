	/// Made-up product attribute number 11.
	column 'Attribute 11'
		dataType: string
		summarizeBy: none
		sourceColumn: Attribute11

	/// Made-up product attribute number 12.
	column 'Attribute 12'
		dataType: string
		summarizeBy: none
		sourceColumn: Attribute12

	/// Made-up product attribute number 13.
	column 'Attribute 13'
		dataType: string
		summarizeBy: none
		sourceColumn: Attribute13

	/// Made-up product attribute number 14.
	column 'Attribute 14'
		dataType: string
		summarizeBy: none
		sourceColumn: Attribute14

	/// Made-up product attribute number 15.
	column 'Attribute 15'
