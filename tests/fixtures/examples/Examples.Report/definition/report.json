{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/report/3.3.0/schema.json",
  "themeCollection": {
    "customTheme": {
      "name": "fixture-theme.json",
      "reportVersionAtImport": {
        "visual": "2.5.0",
        "report": "3.1.0",
        "page": "2.3.0"
      },
      "type": "RegisteredResources"
    }
  },
  "filterConfig": {
    "filters": [
      {
        "name": "ReportFilterYear",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Date"
              }
            },
            "Property": "Year"
          }
        },
        "type": "Categorical",
        "filter": {
          "Version": 2,
          "From": [
            {
              "Name": "d",
              "Entity": "Date",
              "Type": 0
            }
          ],
          "Where": [
            {
              "Condition": {
                "In": {
                  "Expressions": [
                    {
                      "Column": {
                        "Expression": {
                          "SourceRef": {
                            "Source": "d"
                          }
                        },
                        "Property": "Year"
                      }
                    }
                  ],
                  "Values": [
                    [
                      {
                        "Literal": {
                          "Value": "2024L"
                        }
                      }
                    ]
                  ]
                }
              }
            }
          ]
        },
        "howCreated": "User"
      }
    ]
  },
  "settings": {
    "useCrossReportDrillthrough": true
  },
  "resourcePackages": [
    {
      "name": "RegisteredResources",
      "type": "RegisteredResources",
      "items": [
        {
          "name": "fixture-theme.json",
          "path": "fixture-theme.json",
          "type": "CustomTheme"
        },
        {
          "name": "example-image.svg",
          "path": "example-image.svg",
          "type": "Image"
        }
      ]
    }
  ]
}
