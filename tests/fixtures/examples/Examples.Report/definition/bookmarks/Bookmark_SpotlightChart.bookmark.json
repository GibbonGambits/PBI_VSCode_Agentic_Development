{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/bookmark/2.1.0/schema.json",
  "displayName": "Spotlight on the chart",
  "name": "Bookmark_SpotlightChart",
  "options": {
    "targetVisualNames": [
      "Bookmarks_ClusteredColumn_SalesByChannel",
      "Bookmarks_Table_SalesByChannel"
    ],
    "suppressData": true,
    "suppressDisplay": false,
    "suppressActiveSection": true,
    "applyOnlyToTargetVisuals": false
  },
  "explorationState": {
    "version": "1.3",
    "activeSection": "Bookmarks",
    "sections": {
      "Bookmarks": {
        "visualContainers": {
          "Bookmarks_ClusteredColumn_SalesByChannel": {
            "singleVisual": {
              "display": {
                "mode": "spotlight"
              }
            }
          },
          "Bookmarks_Table_SalesByChannel": {
            "singleVisual": {
              "display": {
                "mode": "hidden"
              }
            }
          }
        }
      }
    }
  }
}
