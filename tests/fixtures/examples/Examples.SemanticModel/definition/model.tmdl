model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	selectionExpressionBehavior: nonVisual

/// Example of a query group: holds the parameters.
queryGroup Parameters

/// Example of a query group: holds the staging queries that no table loads directly.
queryGroup Staging

ref table Date
ref table Store
ref table 'Store Detail'
ref table Product
ref table 'Sales Target'
ref table 'Sales Channel'
ref table Sales
ref table _Measures
ref table 'Time Calculation'
ref table 'Sales Metric'
ref table 'Sales Breakdown'
ref table 'Discount Percentage'

ref role 'Northport Stores'
ref role 'Own Store'
ref role 'No Product Cost'
ref role 'No Sales Targets'

ref perspective 'Sales Overview'

ref cultureInfo nl-NL
ref cultureInfo en-US

