/// Example of the measure table as a calculated table: it holds every measure of the model.
table _Measures

	/// Sum of the order line amounts; summary queries are answered by the aggregation table.
	measure 'Total Sales' = SUM ( Sales[Amount] )
		formatString: #,0.00
		displayFolder: Finance\Base

	/// Number of order lines.
	measure '# Order Lines' = COUNTROWS ( Sales )
		formatString: #,0
		displayFolder: Finance\Counts

	column Placeholder
		isHidden
		isNameInferred
		sourceColumn: [Placeholder]

	partition _Measures = calculated
		mode: import
		source = ROW ( "Placeholder", BLANK () )

	annotation CalculatedReason = Shipped example: an entered (imported) table would add an import table to this model, so the measure table is a calculated table that names no other table.

