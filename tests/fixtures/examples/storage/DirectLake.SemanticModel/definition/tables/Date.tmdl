/// Example of a Direct Lake table: one row per calendar day. Made-up source.
table Date
	dataCategory: Time

	column 'Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_key

	/// The calendar day.
	column Date
		dataType: dateTime
		isKey
		formatString: Short Date
		summarizeBy: none
		sourceColumn: date

	/// Calendar year.
	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: year

	partition Date = entity
		mode: directLake
		source
			entityName: date
			schemaName: dbo
			expressionSource: 'DirectLake - Shop'

