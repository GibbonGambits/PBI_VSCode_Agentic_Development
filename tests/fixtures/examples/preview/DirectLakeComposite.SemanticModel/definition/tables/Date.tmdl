/// Example of an import table in a model with Direct Lake on OneLake tables (preview): one row per calendar day. Made-up data.
table Date
	dataCategory: Time

	column 'Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Date Key

	/// The calendar day.
	column Date
		dataType: dateTime
		isKey
		formatString: Short Date
		summarizeBy: none
		sourceColumn: Date

	/// Calendar year.
	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Year

	partition Date = m
		mode: import
		source =
				let
				    // Build a small made-up list of days.
				    Source = #table(
				        type table [#"Date Key" = Int64.Type, Date = datetime, Year = Int64.Type],
				        {
				            {20240105, #datetime(2024, 1, 5, 0, 0, 0), 2024},
				            {20240212, #datetime(2024, 2, 12, 0, 0, 0), 2024}
				        }
				    )
				in
				    Source

