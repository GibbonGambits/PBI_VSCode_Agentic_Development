/// One row per calendar day. Made-up data.
table Date
	dataCategory: Time

	/// The calendar day.
	column Date
		dataType: dateTime
		isKey
		isNullable: false
		formatString: Short Date
		summarizeBy: none
		sourceColumn: Date

	column 'Date Key'
		dataType: int64
		isNullable: false
		isHidden
		summarizeBy: none
		sourceColumn: Date Key

	/// Calendar year.
	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Year

	/// Name of the month.
	column 'Month Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Month Name
		sortByColumn: 'Month Number'

	column 'Month Number'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Month Number

	/// Year, then month, then day.
	hierarchy Calendar

		level Year
			column: Year

		level Month
			column: 'Month Name'

		level Day
			column: Date

	partition Date = m
		mode: import
		source =
				let
				    // Build a small made-up calendar.
				    Source = #table(type table [Date = date, #"Date Key" = Int64.Type, Year = Int64.Type, #"Month Name" = text, #"Month Number" = Int64.Type], {{#date(2024, 1, 1), 20240101, 2024, "January", 1}})
				in
				    Source
